# DB接続情報（値はダミー。各自の環境に合わせて .env を作成すること）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
# APIサーバの待ち受けポート
PORT=3000
# DB接続プールの設定（省略時は既定値。いずれも正の整数）
# プールの最大接続数
DB_POOL_MAX=10
# 1文あたりの実行時間の上限（ミリ秒）。超えた SQL は DB 側で中断される
DB_STATEMENT_TIMEOUT_MS=5000
# プールから接続を取得するまでの待ち時間の上限（ミリ秒）
DB_CONNECTION_TIMEOUT_MS=5000
